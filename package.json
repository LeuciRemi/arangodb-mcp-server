{
  "name": "arangodb-mcp-server",
  "version": "2.0.0",
  "description": "Safe, bounded Model Context Protocol server for exploring and querying ArangoDB databases",
  "license": "MIT",
  "author": "Lucas DE ANGELIS <deangelis.lucas@outlook.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LeuciRemi/arangodb-mcp-server.git"
  },
  "homepage": "https://github.com/LeuciRemi/arangodb-mcp-server#readme",
  "bugs": "https://github.com/LeuciRemi/arangodb-mcp-server/issues",
  "keywords": [
    "arangodb",
    "mcp",
    "model-context-protocol",
    "aql"
  ],
  "type": "module",
  "bin": {
    "arangodb-mcp-server": "dist/index.js"
  },
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "scripts": {
    "clean": "shx rm -rf dist",
    "generate-data": "node dev/generate-ecommerce-data.cjs && node dev/generate-library-data.cjs",
    "docker:build": "docker build -t arangodb-for-arangodb-mcp-server dev",
    "docker:run": "docker run -p 127.0.0.1:18529:8529 -e ARANGO_ROOT_PASSWORD=root -d --name arangodb-for-arangodb-mcp-server-dev arangodb-for-arangodb-mcp-server",
    "docker:stop": "docker stop arangodb-for-arangodb-mcp-server-dev",
    "docker:remove": "docker rm arangodb-for-arangodb-mcp-server-dev",
    "dev:setup": "npm run generate-data && npm run docker:build && npm run docker:run",
    "dev:teardown": "npm run docker:stop && npm run docker:remove",
    "dev": "nodemon",
    "build": "npm run clean && tsc && shx chmod +x dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "npm run build && node --test test/unit/*.test.mjs",
    "test:integration": "npm run build && node --test test/integration/*.test.mjs",
    "test:integration:docker": "node test/run-integration-docker.mjs",
    "test:package": "node test/smoke-package.mjs",
    "check": "npm run typecheck && npm run test:unit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "arangojs": "^10.3.1",
    "zod": "^4.4.3"
  },
  "overrides": {
    "@hono/node-server": "2.0.12",
    "fast-uri": "3.1.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "shx": "^0.4.0",
    "typescript": "^7.0.2"
  }
}
